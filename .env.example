# =============================================================================
# OFKA — environment configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# --- Required ---
# Telegram bot token from @BotFather. Format: <digits>:<base64-ish-chars>
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Your Telegram user id (numeric). Admin-only commands check this.
# Find out via @userinfobot or similar.
ADMIN_ID=123456789

# --- Optional (defaults shown) ---

# SQLAlchemy async URL. Default is local SQLite under ./data/.
# In Docker the path is /app/data/bot.db (mounted as a volume).
#DATABASE_URL=sqlite+aiosqlite:///data/bot.db

# How often the scheduler checks GamerPower for new giveaways, in minutes.
# Recommended: 10-30. Lower values = more API calls (rate-limited).
#CHECK_INTERVAL_MINUTES=15

# Max length of an incoming callback_data payload (Telegram limit is 64 bytes,
# we allow more for forward-compat but validate to prevent abuse).
#MAX_CALLBACK_LENGTH=256

# Max length of an admin broadcast message in characters.
#MAX_MESSAGE_LENGTH=4096

# Per-user action rate limit. 30/min is enough for normal use.
#USER_RATE_LIMIT_PER_MINUTE=30

# Anti-spam cooldown between user actions, seconds.
#SPAM_COOLDOWN_SECONDS=1

# Cooldown for expensive admin actions (/force_check, /broadcast, /backfill), seconds.
#ADMIN_COOLDOWN_SECONDS=30

# Backfill command defaults.
#BACKFILL_DEFAULT_LIMIT=20
#BACKFILL_MAX_LIMIT=100

# GamerPower API endpoint. Default filters to PC platform game giveaways.
#GAMERPOWER_API_URL=https://www.gamerpower.com/api/filter?platform=pc&type=game&sort-by=date

# Comma-separated list of domains to exclude from giveaways.
# Games whose open_giveaway_url contains any of these will be filtered out.
#BLOCKED_GIVEAWAY_DOMAINS=freebies.indiegala.com,itch.io
